{
  "name": "yt-clip",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && playwright test",
    "check:telop": "npm run build && YT_CLIP_TELOP_CHECK=1 playwright test e2e/telop-check.spec.ts",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "preversion": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@playwright/test": "^1.47.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
